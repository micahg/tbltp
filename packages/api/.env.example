# Copy to packages/api/.env (gitignored; loaded by the VS Code "Run API" launch config).
DISABLE_AUTH=true

# Local object storage (localstack from compose.dev.yaml). Create the bucket
# once with:
#   docker compose -f compose.dev.yaml exec localstack awslocal s3 mb s3://tbltp-local
STORAGE_S3_ENDPOINT=http://127.0.0.1:4566
STORAGE_S3_BUCKET=tbltp-local
STORAGE_S3_ACCESS_KEY_ID=test
STORAGE_S3_SECRET_ACCESS_KEY=test
STORAGE_S3_REGION=us-east-1
STORAGE_S3_FORCE_PATH_STYLE=true

# Default, matches the mongo service in compose.dev.yaml
# MONGO_URL=mongodb://localhost:27017/tbltp

# Optional telemetry -- see packages/api/README.md#telemetry
# LOKI_URL=
# LOKI_USER_ID=
# LOKI_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=
